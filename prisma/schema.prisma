generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               String         @id @default(cuid())
  clerkId          String?        @unique
  email            String         @unique
  name             String?
  image            String?
  role             String         @default("CUSTOMER") // CUSTOMER, ADMIN
  stripeCustomerId String?        @unique
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  subscriptions    Subscription[]
  orders           Order[]
  tasteProfiles    TasteProfile[]
}

model Subscription {
  id                   String   @id @default(cuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeSubscriptionId String   @unique
  stripePriceId        String
  status               String   @default("ACTIVE") // ACTIVE, PAUSED, CANCELED, PAST_DUE
  frequency            String   @default("MONTHLY") // WEEKLY, BIWEEKLY, MONTHLY
  grindPreference      String   @default("WHOLE_BEAN") // WHOLE_BEAN, ESPRESSO, FRENCH_PRESS, DRIP
  roastPreference      String   @default("MEDIUM") // LIGHT, MEDIUM, DARK
  quantity             Int      @default(1)
  currentPeriodStart   DateTime @default(now())
  currentPeriodEnd     DateTime @default(now())
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Product {
  id                     String      @id @default(cuid())
  name                   String
  slug                   String      @unique
  description            String
  price                  Float
  roastLevel             String
  origin                 String
  notes                  String      // Comma-separated or JSON
  imageUrl               String
  stock                  Int         @default(100)
  isSubscriptionEligible Boolean     @default(true)
  stripePriceId          String?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  orderItems             OrderItem[]
}

model Order {
  id              String      @id @default(cuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  status          String      @default("PENDING") // PENDING, PROCESSING, SHIPPED, DELIVERED, CANCELED
  totalAmount     Float
  shippingAddress String      // JSON string of address
  stripePaymentId String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  items           OrderItem[]
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
}

model TasteProfile {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  preferredBrew String   // V60, Espresso, Aeropress, French Press
  flavorNotes   String   // Comma separated notes e.g. Fruity, Chocolatey, Nutty
  grindSize     Int      @default(5)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
